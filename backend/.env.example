# Which AI backend generates NEW analyses: "ollama" (free, local, default)
# or "openai" (hosted, costs money per call). Demo filings are served from
# pre-seeded cache either way, so the app is explorable with zero AI setup.
AI_PROVIDER=ollama

# --- Local AI (Ollama) ---
# Install from https://ollama.com, then: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Cloud AI (OpenAI) --- only needed if AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Required by SEC EDGAR fair-access policy: "App Name Contact-Email"
# See https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="SEC Filing Analyzer contact@example.com"

# Database connection string (SQLite by default, swap for PostgreSQL in production)
# e.g. postgresql+psycopg2://user:password@localhost:5432/sec_filing_analyzer
DATABASE_URL=sqlite:///./sec_filing_analyzer.db

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
